    {
      "id": "disc1/allbin/u38/minigame_page/ref0207",
      "ko": "한 장 받지."
    },
    {
      "id": "disc1/allbin/u38/minigame_page/ref0208",
      "ko": "이제 됐네."
    },
    {
      "id": "disc1/allbin/u38/minigame_page/ref0209",
      "ko": "클레어~, 버스트했어.\n…………반응이 없군."
